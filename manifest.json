{
  "manifest_version": 3,
  "name": "コメント先読み＆未視聴のみ",
  "version": "1.3.0",
  "description": "YouTubeで動画を開く前に人気コメントを確認し、チャンネルの動画一覧を未視聴だけに絞り込んで連続再生できます。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "filter.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}